ANTHROPIC_API_KEY=your_anthropic_api_key_here
CHROMA_PERSIST_DIR=./chroma_db
# Embeddings: sentence-transformers (default) or hash (offline stand-in used by the tests)
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Retrieval: hybrid (BM25 + vector, reciprocal-rank fusion), vector or bm25
RETRIEVAL_MODE=hybrid
RETRIEVAL_COLLECTIONS=past_incidents,crawled_docs
